%%%%%%%%% First let us choose our paper size %%%%%%%%%
%Two options: folio vs. quarto and iso vs. letter. 
% quarto TRUE and iso TRUE: outputs a PDF sized for A6 pages, designed to be printed out as a quarto (= 4 pages per side of a sheet of paper, or 8 pages total per sheet) on A4 paper. Your textblock will be A6.
%% Environments: quarto, iso, a5

% quarto FALSE and iso TRUE: outputs a PDF sized for A5 pages, designed to be printed out as a folio (= 2 pages per side of a sheet of paper, or 4 pages total per sheet) on A4 paper. Your textblock will be A5.
%% Environments: folio, iso, a4

% quarto TRUE and iso FALSE: outputs a PDF sized for quarter-letter (4.25"x5.5") pages, designed to be printed out as a quarto (= 4 pages per side of a sheet of paper, or 8 pages total per sheet) on US letter paper. Your textblock will be 4.25"x5.5".
%% Environments: quarto, usletter, letterquarto

% quarto FALSE and iso FALSE: outputs a PDF sized for half-letter (5.5"x8.5") pages, designed to be printed out as a folio (= 2 pages per side of a sheet of paper, or 4 pages total per sheet) on US letter paper. Your textblock will be 5.5"x8.5".
%% Environments: folio, usletter, letterfolio

\newcommand{\ifquarto}[2]{\ifbindery@quarto #1\else #2\fi} %macro to do quarto/folio specific things in documents
% \newcommand{\ifiso}[2]{\ifbindery@iso #1\else #2\fi} %macro to do iso/usletter specific things in documents

\newcommand{\basicwidth}{\textwidth}
\newcommand{\basicscale}{1.0} %there is probably a better way to do this

\newif\ifafourfolio \newif\ifletterfolio \newif\ifafourquarto
\newif\ifletterquarto
\newif\ifbindery@quarto \newif\ifbindery@iso
\newdimen\bindery@skew

\ifdim\paperheight<180mm \bindery@quartotrue \else \bindery@quartofalse \fi

\bindery@skew=\dimexpr\paperheight-1.4142\paperwidth\relax
\ifdim\bindery@skew<-5mm \bindery@isofalse
\else\ifdim\bindery@skew>5mm \bindery@isofalse \else \bindery@isotrue \fi\fi

\ifbindery@quarto
\ifbindery@iso \afourquartotrue \else \letterquartotrue \fi
\else
\ifbindery@iso \afourfoliotrue \else \letterfoliotrue \fi
\fi

\ifbindery@iso
